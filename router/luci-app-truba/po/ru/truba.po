msgstr "Аварийная блокировка (трафик «Туннель» отбрасывается)"

msgid "via tunnel"
msgstr "через Туннель"

msgid "fallback to direct (no tunnel route)"
msgstr "обход напрямую (маршрута через Туннель нет)"

msgid "Last handshake"
msgstr "Последний handshake"

msgid "Tunnel address"
msgstr "Адрес в Туннеле"

msgid "Tunnel route table"
msgstr "Таблица Туннеля"

msgid "Tunnel watchdog"
msgstr "Контроль Туннеля"

msgid "healthy since"
msgstr "в порядке с"

msgid "down since"
msgstr "не работает с"

