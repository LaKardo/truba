msgstr "Протокол"

msgid "External port"
msgstr "Внешний порт"

msgid "Device"
msgstr "Устройство"

msgid "State"
msgstr "Состояние"

msgid "No port forwards with source zone «truba»."
msgstr "Нет пробросов портов из зоны «truba»."

msgid "Edit port forwards"
msgstr "Изменить пробросы портов"

msgid "Choose source zone «truba»."
msgstr "Выберите зону-источник «truba»."

msgid "Update in progress…"
msgstr "Идёт обновление…"

msgid "Applying settings…"
msgstr "Применяются настройки…"

msgid "Rule sets are being updated, try again later."
msgstr "Наборы правил обновляются, попробуйте позже."

