msgstr "Последняя проверка: %s"

msgid "geoip.dat and geosite.dat from kirilllavrov/geoip-builder and kirilllavrov/geosite-builder. Files are used unchanged; the checksum is verified before every replacement."
msgstr "geoip.dat и geosite.dat из kirilllavrov/geoip-builder и kirilllavrov/geosite-builder. Файлы используются без изменений; контрольная сумма проверяется перед каждой заменой."

msgid "geoip.dat"
msgstr "geoip.dat"

msgid "geoip.dat mirror"
msgstr "Зеркало geoip.dat"

msgid "Downloaded directly if the main source failed."
msgstr "Скачивается напрямую, если основной источник не ответил."

msgid "geosite.dat"
msgstr "geosite.dat"

msgid "geosite.dat mirror"
msgstr "Зеркало geosite.dat"

msgid "Download via tunnel"
msgstr "Скачивать через Туннель"

msgid "The main source is fetched through the tunnel; the mirror always goes direct."
msgstr "Основной источник скачивается через Туннель, зеркало — всегда напрямую."

msgid "Update automatically"
msgstr "Обновлять автоматически"

msgid "Update time (UTC)"
msgstr "Время обновления (UTC)"

msgid "Format: HH:MM"
msgstr "Формат: ЧЧ:ММ"

msgid "Update started."
msgstr "Обновление запущено."

msgid "Update now"
msgstr "Обновить сейчас"

msgid "Swap current and previous rule sets?"
msgstr "Поменять местами текущие и предыдущие Наборы правил?"

