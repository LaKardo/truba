#!/bin/sh
# Первичная настройка при установке пакета truba. Всё откатывается /usr/share/truba/uninstall.sh.

# Пути, имя зоны и интерфейса — у службы (ADR 0015). Без них настраивать нечего: код ошибки
# оставляет скрипт, и uci-defaults повторит его при следующей загрузке.
eval "$(/usr/sbin/truba env)"
[ -n "$TRUBA_FW_ZONE" ] || exit 1

STATE="$TRUBA_STATE_DIR"
ZONE="$TRUBA_FW_ZONE"
mkdir -p "$STATE"

# Этот скрипт идёт и после каждого обновления пакета. Первая установка — пока нет
# firewall.orig: он пишется ниже и удаляется только вместе с пакетом.
FIRST=0
[ -f "$STATE/firewall.orig" ] || FIRST=1

# Исходные значения межсетевого экрана — чтобы вернуть их при удалении.
if [ ! -f "$STATE/firewall.orig" ]; then
	{
		echo "fullcone=$(uci -q get firewall.@defaults[0].fullcone)"
		echo "flow_offloading_hw=$(uci -q get firewall.@defaults[0].flow_offloading_hw)"
	} > "$STATE/firewall.orig"
fi

# Full cone NAT; аппаратное ускорение выключено: оно обходит netfilter целиком (docs/architecture.md §4.2).
# Программное ускорение не трогаем: его выбирает владелец. Пакеты ускоренных соединений
# идут мимо счётчиков Трубы и мимо шейперов трафика — об этом предупреждает «Обзор».
uci -q set firewall.@defaults[0].fullcone='1'
uci -q set firewall.@defaults[0].flow_offloading_hw='0'

# Зона Туннеля: masq + fullcone, вход на сам Роутер закрыт. Перенаправления в неё из зон
# Маршрутизации (lan_truba и другие) заводит служба при каждом применении (ADR 0014).
if [ -z "$(uci -q get "firewall.$ZONE")" ]; then
	uci -q batch <<-EOF
		set firewall.$ZONE=zone
		set firewall.$ZONE.name='$ZONE'
		add_list firewall.$ZONE.network='$TRUBA_IFACE'
		set firewall.$ZONE.input='REJECT'
		set firewall.$ZONE.output='ACCEPT'
		set firewall.$ZONE.forward='REJECT'
		set firewall.$ZONE.masq='1'
		set firewall.$ZONE.mtu_fix='1'
	EOF
fi

# IPv6 домашней сети не трогаем (link-local нужен mesh-узлам, ADR 0005); закрываем только выход в интернет по IPv6.
if [ -z "$(uci -q get firewall.truba_no_ipv6_inet)" ]; then
	uci -q batch <<-EOF
		set firewall.truba_no_ipv6_inet=rule
		set firewall.truba_no_ipv6_inet.name='Truba: no IPv6 internet from LAN'
		set firewall.truba_no_ipv6_inet.src='lan'
		set firewall.truba_no_ipv6_inet.dest='wan'
		set firewall.truba_no_ipv6_inet.family='ipv6'
		set firewall.truba_no_ipv6_inet.proto='all'
		set firewall.truba_no_ipv6_inet.target='REJECT'
	EOF
fi

uci -q commit firewall

# Стартовые настройки Категорий — только при первой установке и если правил ещё нет:
# Категории, которые владелец убрал, обновление пакета не возвращает.
if [ "$FIRST" = 1 ] && [ -z "$(uci -q show truba | grep '=rule$')" ]; then
	/usr/sbin/truba reset-rules all >/dev/null 2>&1
	/usr/sbin/truba reset-rules selective >/dev/null 2>&1
fi

# mosdns запускает служба truba со своим конфигом.
[ -x /etc/init.d/mosdns ] && {
	/etc/init.d/mosdns stop >/dev/null 2>&1
	/etc/init.d/mosdns disable >/dev/null 2>&1
}

# Переустановка пакетов после sysupgrade (ADR 0004).
# Строка — перед «exit 0», а если его нет, в конец; awk вставляет её как есть, без экранирования для sed.
RUN="[ -x $TRUBA_REINSTALL ] && $TRUBA_REINSTALL &"
if [ -f /etc/rc.local ] && ! grep -qF "$TRUBA_REINSTALL" /etc/rc.local; then
	awk -v run="$RUN" '/^exit 0$/ && !done { print run; done = 1 } { print }' /etc/rc.local > /tmp/rc.local.truba &&
		cat /tmp/rc.local.truba > /etc/rc.local
	rm -f /tmp/rc.local.truba
	grep -qF "$TRUBA_REINSTALL" /etc/rc.local || echo "$RUN" >> /etc/rc.local
fi

exit 0
