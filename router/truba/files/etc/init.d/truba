#!/bin/sh /etc/rc.common
# Труба: применяет /etc/config/truba и держит mosdns, контроль Туннеля и историю скорости.
# reload = повторный start: truba apply сверяет систему с настройками,
# а procd перезапускает только те инстансы, у которых изменились параметры или файлы.

START=99
STOP=10
USE_PROCD=1

PROG=/usr/sbin/truba

start_service() {
	local rc=0 mosdns watchdog
	# Ошибка apply не снимает службы (ADR 0006): rc.common передаёт procd только те инстансы,
	# что открыты здесь, и без них procd остановил бы mosdns, а dnsmasq продолжал бы слать
	# запросы ему — DNS всей сети пропал бы. При ошибке apply оставляет действующие правила
	# (или последнюю удачную копию) и пишет в applied.json, нужен ли им mosdns.
	$PROG apply >/dev/null || rc=1

	config_load truba
	config_get_bool watchdog watchdog enabled 1
	mosdns="$(jsonfilter -q -i /var/run/truba/applied.json -e '@.mosdns')"

	if [ "$mosdns" = true ] && [ -s /var/etc/truba/mosdns.json ]; then
		procd_open_instance mosdns
		procd_set_param command /usr/bin/mosdns start -c /var/etc/truba/mosdns.json -d /var/lib/truba
		procd_set_param file /var/etc/truba/mosdns.json /var/lib/truba/stamp
		procd_set_param respawn 3600 5 0
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi

	if [ "$watchdog" -eq 1 ]; then
		procd_open_instance watchdog
		procd_set_param command $PROG watchdog
		# И код: после обновления пакета reload перезапускает watchdog с новым кодом,
		# а не оставляет прежний процесс до перезагрузки.
		procd_set_param file /etc/config/truba $PROG /usr/share/ucode/truba/*.uc
		procd_set_param respawn 3600 5 0
		procd_set_param stderr 1
		procd_close_instance
	fi

	# История скорости для графика «Обзора»: пишется всегда, даже когда браузер закрыт.
	procd_open_instance stats
	procd_set_param command $PROG stats
	procd_set_param file $PROG /usr/share/ucode/truba/*.uc
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance

	return $rc
}

stop_service() {
	$PROG teardown
}

service_triggers() {
	local iface
	iface="$(uci -q get truba.main.iface)"
	procd_add_reload_trigger "truba" "network"
	procd_add_interface_trigger "interface.*" "${iface:-awg0}" /etc/init.d/truba reload
}
