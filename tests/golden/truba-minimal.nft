table inet truba
delete table inet truba
table inet truba {
	set lan_if {
		type ifname;
		elements = { "br-lan" }
	}
	set dv_tunnel_down {
		type ipv4_addr;
		flags dynamic,timeout;
		timeout 86400s;
		size 1024;
		counter;
	}
	set dv_tunnel_up {
		type ipv4_addr;
		flags dynamic,timeout;
		timeout 86400s;
		size 1024;
		counter;
	}
	set dv_direct_down {
		type ipv4_addr;
		flags dynamic,timeout;
		timeout 86400s;
		size 1024;
		counter;
	}
	set dv_direct_up {
		type ipv4_addr;
		flags dynamic,timeout;
		timeout 86400s;
		size 1024;
		counter;
	}
	set dv_inbound_down {
		type ipv4_addr;
		flags dynamic,timeout;
		timeout 86400s;
		size 1024;
		counter;
	}
	set dv_inbound_up {
		type ipv4_addr;
		flags dynamic,timeout;
		timeout 86400s;
		size 1024;
		counter;
	}
	counter c_inbound { }
	counter c_tunnel_down { }
	counter c_tunnel_up { packets 3 bytes 900 }
	counter c_direct_down { }
	counter c_direct_up { }
	counter c_inbound_down { }
	counter c_inbound_up { }

	chain prerouting {
		type filter hook prerouting priority mangle + 10; policy accept;
		meta nfproto != ipv4 return
		iifname "awg0" ct state new counter name c_inbound
		iifname "awg0" meta mark set meta mark and 0xf0ffffff or 0x04000000 return
		iifname @lan_if ct mark and 0x0f000000 == 0x04000000 meta mark set meta mark and 0xf0ffffff or 0x01000000 return
		iifname @lan_if ct mark and 0x0f000000 == 0x01000000 meta mark set meta mark and 0xf0ffffff or 0x01000000 return
	}

	chain persist {
		type filter hook postrouting priority 300; policy accept;
		meta nfproto != ipv4 return
		meta mark and 0x0f000000 == 0x04000000 ct mark set ct mark and 0xf0ffffff or 0x04000000 return
		meta mark and 0x0f000000 == 0x01000000 ct mark set ct mark and 0xf0ffffff or 0x01000000 return
		meta mark and 0x0f000000 == 0x02000000 ct mark set ct mark and 0xf0ffffff or 0x02000000 return
	}

	chain stats {
		type filter hook forward priority filter + 10; policy accept;
		meta nfproto != ipv4 return
		iifname @lan_if oifname @lan_if return
		iifname @lan_if oifname "awg0" ct direction original counter name c_tunnel_up update @dv_tunnel_up { ip saddr } return
		iifname "awg0" oifname @lan_if ct direction reply counter name c_tunnel_down update @dv_tunnel_down { ip daddr } return
		iifname "awg0" oifname @lan_if ct direction original counter name c_inbound_down update @dv_inbound_down { ip daddr } return
		iifname @lan_if oifname "awg0" ct direction reply counter name c_inbound_up update @dv_inbound_up { ip saddr } return
		iifname @lan_if oifname != "awg0" ct direction original counter name c_direct_up update @dv_direct_up { ip saddr } return
		iifname != "awg0" oifname @lan_if ct direction reply counter name c_direct_down update @dv_direct_down { ip daddr } return
	}

	chain output {
		type route hook output priority mangle + 10; policy accept;
		meta nfproto != ipv4 return
		ip daddr 203.0.113.10 ip dscp != cs0 ip dscp set cs0
		ip daddr 203.0.113.10 meta mark set meta mark and 0xf0ffffff or 0x02000000 return
		socket mark and 0x0f000000 == 0x01000000 meta mark set meta mark and 0xf0ffffff or 0x01000000
	}
}
